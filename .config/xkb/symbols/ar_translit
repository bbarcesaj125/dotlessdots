    key <AD12> { [ Arabic_sheen, Arabic_sheen, plus, asterisk ] };

    key <AC01> { [ Arabic_qaf, Arabic_qaf, q, Q ] };
    key <AC02> { [ Arabic_seen, Arabic_sad, s, S ] };
    key <AC03> { [ Arabic_dal, Arabic_dad, d, D ] };
    key <AC04> { [ Arabic_feh, Arabic_fathatan, f, F ] };
    key <AC05> { [ Arabic_ghain, Arabic_ghain, g, G ] };
    key <AC06> { [ Arabic_ha, Arabic_sukun, h, H ] };
