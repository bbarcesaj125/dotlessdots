    key <AC09> { [ Arabic_lam, Arabic_lam, l, L ] };
    key <AC10> { [ Arabic_meem, Arabic_meem, m, M ] };
    key <AC11> { [ Arabic_theh, percent, ugrave, Ugrave ] };

    key <LSGT> { [ less, greater, bar ] };
    key <AB01> { [ Arabic_waw, Arabic_hamzaonwaw, w, W ] };
    key <AB02> { [ Arabic_khah, Arabic_khah, x, X ] };
    key <AB03> { [ Arabic_hah, Arabic_hah, c, C ] };
    key <AB04> { [ Arabic_alefmaksura, Arabic_tatweel, v, V ] };
    key <AB05> { [ Arabic_beh, Arabic_beh, b, B ] };
    key <AB06> { [ Arabic_noon, Arabic_dammatan, n, N ] };
    key <AB07> { [ Arabic_comma, Arabic_question_mark, comma, question ] };
    key <AB08> { [ period, Arabic_semicolon, semicolon, period ] };
